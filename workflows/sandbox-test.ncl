# Provision the machine as `runner`, then run as the sandbox user and check
# that the sandbox holds nothing of the job's credentials and that escape
# attempts fail, then publish as runner from what the sandbox staged. ci.yml runs it; compiled to
# .github/workflows/sandbox-test.lock.yml.
let gha = import "../lib/gha.ncl" in
let checkout = "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1" in # v7.0.1

gha.compile {
  name = "Sandbox test",
  on = { workflow_call = {}, workflow_dispatch = {} },
  permissions = { contents = "read" },
  jobs.sandbox = {
    "runs-on" = "ubuntu-26.04",
    "timeout-minutes" = 15,
    sandbox.user = "runner-sandbox",
    # What git tracks, plus what a runner step generates below.
    handoff.include = ["generated"],
    runner_steps = [
      { uses = checkout, with = { persist-credentials = false } },
      {
        name = "Install a tool system-wide",
        shell = "bash",
        run = m%"
          sudo tee /usr/local/bin/hello-tool >/dev/null <<'EOF'
          #!/bin/sh
          echo "installed by runner_steps, run by $(id -un)"
          EOF
          sudo chmod 0755 /usr/local/bin/hello-tool
          echo RUNNER-SECRET-MARKER >"$HOME/runner-secret.txt"
          ln -s /etc/shadow shadow-link
          ln -s /etc shadow-dir
          mkdir generated
          echo "generated by runner_steps" >generated/data.txt
          echo "left behind by runner_steps" >untracked.txt
        "%,
      },
      # Shares, read-only to the sandbox: content, a file, a directory.
      { share = { name = "greeting", content = "hello from ${{ github.job }}" } },
      { share = { name = "LICENSE", path = "LICENSE" } },
      { share = { name = "reject-tests", path = "tests/reject" } },
      # A symlink in the checkout must not publish its target.
      { id = "share-symlink", "continue-on-error" = true, share = { name = "shadow", path = "shadow-link" } },
      { id = "share-symlink-dir", "continue-on-error" = true, share = { name = "shadow2", path = "shadow-dir/shadow" } },
    ],
    steps = [
      {
        name = "Runs as the sandbox user",
        run = m%"
          id
          test "$(id -un)" = runner-sandbox
          test "$PWD" = /var/lib/runner-sandbox/work
          test -f LICENSE
        "%,
      },
      {
        name = "Gets the handed-off workspace and nothing else",
        run = m%"
          test "$(stat -c %U LICENSE generated/data.txt | sort -u)" = runner-sandbox
          test "$(cat generated/data.txt)" = "generated by runner_steps"
          for f in untracked.txt shadow-link shadow-dir .git; do
            if test -e "$f" || test -L "$f"; then echo "$f was handed off"; exit 1; fi
          done
        "%,
      },
      {
        name = "Runs in a login session of its own, not as if under sudo",
        run = m%"
          test "$XDG_RUNTIME_DIR" = "/run/user/$(id -u)"
          loginctl show-session "$XDG_SESSION_ID" -p Name -p Class
          test "$(loginctl show-session "$XDG_SESSION_ID" -p Name --value)" = runner-sandbox
          if env | grep ^SUDO_; then echo "SUDO_* leaked into the sandbox"; exit 1; fi
        "%,
      },
      {
        name = "Leave files in /tmp and /var/tmp",
        run = m%"
          echo left >/tmp/sandbox-tmp-marker
          echo left >/var/tmp/sandbox-tmp-marker
        "%,
      },
      {
        name = "Each step gets a private /tmp and /var/tmp",
        run = m%"
          for d in /tmp /var/tmp; do
            if test -e "$d/sandbox-tmp-marker"; then echo "$d is shared between steps"; exit 1; fi
          done
        "%,
      },
      { name = "sudo is refused", id = "sudo", "continue-on-error" = true, run = "sudo -n true" },
      {
        name = "The sudo step failed",
        env = { OUTCOME = "${{ steps.sudo.outcome }}" },
        run = m%"test "$OUTCOME" = failure"%,
      },
      {
        name = "The job's credentials are out of reach",
        run = m%"
          for v in ACTIONS_ID_TOKEN_REQUEST_TOKEN ACTIONS_ID_TOKEN_REQUEST_URL ACTIONS_RUNTIME_TOKEN GITHUB_TOKEN; do
            if [[ -v $v ]]; then echo "$v is set"; exit 1; fi
          done
          # The file commands are the sandbox's own.
          for v in GITHUB_ENV GITHUB_PATH GITHUB_OUTPUT GITHUB_STATE GITHUB_STEP_SUMMARY; do
            test "$(stat -c %U "$(dirname "${!v}")")" = runner-sandbox
          done
          worker=$(pgrep -f Runner.Worker | head -n1)
          test -n "$worker"
          if cat "/proc/$worker/environ" >/dev/null; then echo "read Runner.Worker's environment"; exit 1; fi
          if ls /home/runner >/dev/null; then echo "listed the runner's home"; exit 1; fi
          if docker ps >/dev/null 2>&1; then echo "reached a docker daemon"; exit 1; fi
          echo "no credentials reachable"
        "%,
      },
      {
        name = "Read the shares, and fail to change them",
        env = {
          SYMLINK_SHARE = "${{ steps.share-symlink.outcome }}",
          SYMLINK_DIR_SHARE = "${{ steps.share-symlink-dir.outcome }}",
        },
        run = m%"
          cd %{gha.share_dir}
          ls -lR
          test "$(cat greeting)" = "hello from $GITHUB_JOB"
          cmp LICENSE /var/lib/runner-sandbox/work/LICENSE
          test -f reject-tests/shell-override.ncl
          test "$(stat -c '%U:%G %a' . greeting LICENSE reject-tests reject-tests/shell-override.ncl)" = "$(printf 'root:root %s\n' 755 644 644 755 644)"
          test "$SYMLINK_SHARE" = failure && test ! -e shadow
          test "$SYMLINK_DIR_SHARE" = failure && test ! -e shadow2
          for f in greeting LICENSE reject-tests/shell-override.ncl; do
            if { echo pwned >>"$f"; } 2>/dev/null; then echo "wrote $f"; exit 1; fi
          done
          if touch new reject-tests/new 2>/dev/null; then echo "created a file in a share"; exit 1; fi
          if rm -f greeting 2>/dev/null && test ! -e greeting; then echo "removed a share"; exit 1; fi
          echo "shares are readable and read-only"
        "%,
      },
      { name = "Use what runner_steps installed", run = "hello-tool | tee hello.log" },
      {
        name = "Write a step output",
        id = "out",
        run = m%"
          echo "answer=42" >>"$GITHUB_OUTPUT"
          echo "Written from the sandbox by $(id -un)" >>"$GITHUB_STEP_SUMMARY"
        "%,
      },
      {
        name = "Read it back",
        env = { ANSWER = "${{ steps.out.outputs.answer }}" },
        run = m%"test "$ANSWER" = 42"%,
      },
      # Escape attempts: each must fail, or leave nothing behind.
      {
        name = "Point GITHUB_OUTPUT at a root-only file",
        id = "symlink",
        "continue-on-error" = true,
        run = m%"ln -sf /etc/shadow "$GITHUB_OUTPUT""%,
      },
      {
        name = "Smuggle an output with a bad name",
        id = "heredoc",
        "continue-on-error" = true,
        run = m%"printf 'x y<<EOF\nsomething\nEOF\n' >>"$GITHUB_OUTPUT""%,
      },
      # Workflow commands on standard output and error: all but annotations
      # are passed on neutralized.
      {
        name = "Issue workflow commands",
        id = "commands",
        # Spelled with $c so actionlint doesn't flag the deprecated commands.
        run = m%"
          c=::
          echo "${c}set-output name=smuggled::1"
          echo "  ${c}save-state name=smuggled::1"
          echo "${c}add-mask::runner-sandbox"
          echo "${c}add-path::/tmp/sandbox-bin"
          echo "${c}set-env name=SMUGGLED::1"
          echo "${c}stop-commands::sandbox-token" >&2
          printf 'text\r%sset-output name=cr::1\n' "$c"
          echo "legacy ##[set-output name=legacy;]1"
          echo "${c}warning::an annotation from the sandbox, which is allowed"
        "%,
      },
      {
        name = "No command took effect",
        env = {
          SMUGGLED = "${{ steps.commands.outputs.smuggled }}",
          CR = "${{ steps.commands.outputs.cr }}",
          LEGACY = "${{ steps.commands.outputs.legacy }}",
        },
        run = m%"
          test -z "$SMUGGLED$CR$LEGACY"
          # Masking would have turned the name into *** in this log.
          echo "the sandbox user is runner-sandbox"
        "%,
      },
      {
        name = "Leave a process behind",
        run = m%"setsid sleep 600 </dev/null >/dev/null 2>&1 & echo "started $!""%,
      },
      {
        name = "Leave a process behind and time out",
        id = "timeout",
        "timeout-minutes" = 1,
        "continue-on-error" = true,
        run = m%"
          setsid sleep 600 </dev/null >/dev/null 2>&1 &
          systemd-run --user --quiet sleep 601
          sleep 300
        "%,
      },
      {
        name = "Cron, at and lingering are denied",
        run = m%"
          if echo "* * * * * sleep 602" | crontab - 2>/dev/null; then echo "installed a crontab"; exit 1; fi
          if command -v at >/dev/null && echo "sleep 603" | at now 2>/dev/null; then echo "queued an at job"; exit 1; fi
          if loginctl enable-linger 2>/dev/null; then echo "enabled lingering"; exit 1; fi
        "%,
      },
      {
        name = "The escapes failed",
        env = {
          SYMLINK = "${{ steps.symlink.outcome }}",
          HEREDOC = "${{ steps.heredoc.outcome }}",
          TIMEOUT = "${{ steps.timeout.outcome }}",
        },
        run = m%"
          test "$SYMLINK" = failure
          test "$HEREDOC" = failure
          test "$TIMEOUT" = failure
          if pgrep -u runner-sandbox -a sleep; then echo "a process survived its step"; exit 1; fi
          echo "all escapes failed"
        "%,
      },
      # Uploads: ci.yml checks that no artifact holds the job's runtime
      # token or the runner's secret.
      {
        name = "Point uploads at the runner's secrets",
        run = m%"
          ln -s /proc/self/environ leak-environ
          ln -s /home/runner/runner-secret.txt leak-runner
          ln -s /home/runner leak-via
          mkdir leak-dir
          echo harmless >leak-dir/ok
          ln -s /proc/self/environ leak-dir/environ
        "%,
      },
      { "continue-on-error" = true, upload = { name = "leak-environ", path = "leak-environ" } },
      { "continue-on-error" = true, upload = { name = "leak-runner", path = "leak-runner" } },
      { "continue-on-error" = true, upload = { name = "leak-via", path = "leak-via/runner-secret.txt" } },
      { "continue-on-error" = true, upload = { name = "leak-dir", path = "leak-dir" } },
      {
        name = "Every upload through a symlink was refused",
        env = {
          ENVIRON = "${{ steps.stage-leak-environ.outcome }}",
          RUNNER = "${{ steps.stage-leak-runner.outcome }}",
          VIA = "${{ steps.stage-leak-via.outcome }}",
          DIR = "${{ steps.stage-leak-dir.outcome }}",
        },
        run = m%"
          echo "environ=$ENVIRON runner=$RUNNER via=$VIA dir=$DIR"
          test "$ENVIRON $RUNNER $VIA $DIR" = "failure failure failure failure"
        "%,
      },
      { "if" = "always()", upload = { name = "sandbox-test", path = "hello.log" } },
      # What publish_steps get: a staged copy, and nothing else of the
      # sandbox's.
      {
        name = "Write a report, and leave files where publish steps might look",
        run = m%"
          echo "report from $(id -un)" >report.txt
          echo leftover >/dev/shm/sandbox-leftover
          # One owned by a subordinate uid, through rootless podman.
          podman unshare sh -c 'echo leftover >/dev/shm/subuid-leftover && chown 1:1 /dev/shm/subuid-leftover'
          test "$(stat -c %u /dev/shm/subuid-leftover)" != "$(id -u)"
          mkdir -p ~/private && echo secret-ish >~/private/notes
        "%,
      },
      { stage = { name = "report", path = "report.txt" } },
    ],
    publish_steps = [
      {
        name = "Read the staged report, as runner",
        id = "read-report",
        run = m%"
          test "$(id -un)" = runner
          f=%{gha.staged "report"}/report.txt
          test "$(cat "$f")" = "report from runner-sandbox"
          test "$(stat -c '%U:%G %a' "$f")" = "root:root 644"
          echo "lines=$(wc -l <"$f")" >>"$GITHUB_OUTPUT"
        "%,
      },
      {
        name = "The sandbox is sealed",
        env = { LINES = "${{ steps.read-report.outputs.lines }}" },
        run = m%"
          test "$LINES" = 1
          for p in /var/lib/runner-sandbox/work/report.txt /home/runner-sandbox/private/notes; do
            if cat "$p" 2>/dev/null; then echo "read $p after the seal"; exit 1; fi
          done
          for f in /dev/shm/sandbox-leftover /dev/shm/subuid-leftover; do
            if test -e "$f"; then echo "the sandbox's $f survived the seal"; exit 1; fi
          done
          if pgrep -u runner-sandbox; then echo "a sandbox process survived the seal"; exit 1; fi
          if /usr/local/bin/runner-sandbox-exec --stage late report.txt; then echo "staged after the seal"; exit 1; fi
          if sudo -n true 2>/dev/null; then echo "runner has sudo in the publish phase"; exit 1; fi
          # Same uid as Runner.Worker, but Yama keeps it from its memory.
          worker=$(pgrep -f Runner.Worker | head -n1)
          test -n "$worker"
          if (exec 3<"/proc/$worker/mem") 2>/dev/null; then echo "opened Runner.Worker's memory"; exit 1; fi
          echo "only staged outputs are left"
        "%,
      },
    ],
  },
}
